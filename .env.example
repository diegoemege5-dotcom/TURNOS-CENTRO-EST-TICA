VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ── Script WhatsApp + Gemini ──────────────────────────────────────────────────
# Clave de API de Google AI Studio (Gemini)
GEMINI_API_KEY=<tu-gemini-api-key>

# Service Role Key de Supabase (solo para el script Python — nunca en frontend)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Nombre exacto del chat de WhatsApp a monitorear (dejar vacío = chat activo)
WHATSAPP_CHAT_NAME=

# Ruta del archivo Excel de reportes (por defecto: comprobantes.xlsx)
EXCEL_PATH=comprobantes.xlsx

# Carpeta temporal para descargas de adjuntos
DOWNLOADS_DIR=/tmp/whatsapp_adjuntos

# Segundos entre cada ciclo de lectura del listener
POLL_INTERVAL_SEC=5
